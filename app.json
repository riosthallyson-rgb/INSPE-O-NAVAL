{
  "expo": {
    "name": "Inspetor Naval",
    "slug": "bizu-inspetor-naval",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "portrait",
    "scheme": "bizu-inspetor-naval",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#041F33"
    },
    "android": {
      "package": "com.bizu.inspetornaval",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#041F33"
      }
    },
    "ios": {
      "bundleIdentifier": "com.bizu.inspetornaval",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para anexar imagens de documentos e evidências da inspeção.",
          "cameraPermission": "Permita o acesso à câmera para fotografar documentos e evidências da inspeção.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para capturar documentos, evidências e ler QR Codes durante a inspeção.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita o acesso à localização durante o uso para registrar o ponto da inspeção. O GPS não determina sozinho a jurisdição nem uma regra aplicável.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
