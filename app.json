{
  "expo": {
    "name": "Inspetor Naval",
    "slug": "bizu-inspetor-naval",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "portrait",
    "scheme": "bizu-inspetor-naval",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bizu.inspetornaval",
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.bizu.inspetornaval",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às fotos para anexar uma imagem do TIE.",
          "cameraPermission": "Permita o acesso à câmera para fotografar o TIE.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Permita o acesso à câmera para capturar documentos e ler QR Codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir localização para registrar o local da inspeção e identificar regras regionais aplicáveis.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
